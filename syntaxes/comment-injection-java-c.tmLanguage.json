{
  "scopeName": "java-comment-spec.injection",
  "injectionSelector": "L:source.java,L:source.c,L:source.opencl,L:source.cuda,L:source.cpp",
  
  "patterns": [
      {
        "begin": "\\s*\\/\\*[^@]*@",
        "end": "\\s*\\*\\/",
        "patterns": [
          {
            "name": "constant.character.escape.untitled",
            "match": "\\."
          },
          {
            "include": "source.specification"
          }
        ]
      },
      {
        "begin": "\\s*\\/\\/@",
        "end": "\\\n",
        "patterns": [
          {
            "name": "constant.character.escape.untitled",
            "match": "\\."
          },
          {
            "include": "source.specification"
          }
        ]
      }
  ]
}