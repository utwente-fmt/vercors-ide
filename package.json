{
  "name": "vercorsplugin",
  "displayName": "VerCorsPlugin",
  "license": "MIT",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/utwente-fmt/vercors-ide/"
  },
  "publisher": "VerCors",
  "categories": [],
  "keywords": [
    "multi-root ready"
  ],
  "engines": {
    "vscode": "^1.84.0"
  },
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:java",
    "onCommand:vercors.lspVerify"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "pvl",
        "path": "./syntaxes/snippets.json"
      },
      {
        "language": "java",
        "path": "./syntaxes/snippets.json"
      },
      {
        "language": "c",
        "path": "./syntaxes/snippets.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "VerCors Configuration",
      "properties": {
        "vercorsplugin.vercorsPath": {
          "type": "array",
          "default": [],
          "description": "Keeps track of all added VerCors server folders (path + version + selected)."
        },
        "vercors.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the VerCors server folder (should contain the vercors.jar and res folders)."
        },
        "vercorsplugin.optionsMap": {
          "type": "object",
          "default": {},
          "description": "Stores custom VerCors options per file or context."
        }
      }
    },
    "languages": [
      {
        "id": "pvl",
        "extensions": [
          ".pvl"
        ],
        "configuration": "./syntaxes/pvl-language-configuration.json"
      },
      {
        "id": "java",
        "extensions": [
          ".java"
        ]
      },
      {
        "id": "vercors-output",
        "aliases": [
          "My Output Channel"
        ],
        "extensions": [
          ".myoutput"
        ]
      }
    ],
    "grammars": [
      {
        "language": "pvl",
        "scopeName": "source.pvl",
        "path": "./syntaxes/pvl.tmLanguage.json"
      },
      {
        "path": "./syntaxes/spec-injection-grammar.tmLanguage.json",
        "scopeName": "source.specification",
        "injectTo": [
          "source.pvl"
        ]
      },
      {
        "path": "syntaxes/comment-injection-java-c.tmLanguage.json",
        "scopeName": "java-comment-spec.injection",
        "injectTo": [
          "source.java",
          "source.c",
          "source.opencl",
          "source.cuda-cpp",
          "source.cpp"
        ]
      }
    ],
    "keybindings": [
      {
        "command": "vercors.verify",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "vercors.stop",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q"
      },
      {
        "command": "extension.selectVercorsVersion",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j"
      }
    ],
    "commands": [
      {
        "command": "vercors.verify",
        "title": "VerCors: Verify via LSP",
        "category": "VerCors",
        "icon": "resources/run.svg"
      },
      {
        "command": "vercors.stop",
        "title": "Cancel VerCors Verification",
        "category": "VerCors",
        "icon": "resources/stop.svg"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vercors-plugin",
          "title": "VerCors Plugin",
          "icon": "resources/mountain-icon.svg"
        }
      ]
    },
    "views": {
      "vercors-plugin": [
        {
          "id": "vercorsPathView",
          "name": "VerCors Versions",
          "type": "webview"
        },
        {
          "id": "vercorsOptionsView",
          "name": "Options",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vercors.verify",
          "when": "view == vercorsPathView",
          "group": "navigation"
        },
        {
          "command": "vercors.stop",
          "when": "view == vercorsPathView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "vsce package --ignoreFile .vscodeignore-bundled --readme-path INFO.md",
    "clean": "git clean -xfd client/out client/tsconfig.tsbuildinfo",
    "vscode:prepublish": "npm run clean && npm run esbuild-base -- --minify",
    "esbuild": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./client/src/extension.ts --bundle --outfile=./client/out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run clean && tsc -b",
    "watch": "npm run clean && tsc -b -w",
    "lint": "eslint ./client/src --ext .ts,.tsx",
    "postinstall": "cd client && npm install",
    "test": "npm run clean && npm run compile && sh ./scripts/e2e.sh"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/vsce": "^3.9.2",
    "chai": "^6.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "async-wait-until": "^2.0.31",
    "eventemitter3": "^5.0.4",
    "expect.js": "^0.3.1",
    "mock-fs": "^5.5.0",
    "sinon": "^22.1.0",
    "wait-for-event": "^2.0.1",
    "wdio": "^6.0.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.1": true,
    "keytar@7.9.0": true
  }
}
