{
  "name": "vercorsplugin",
  "displayName": "VerCorsPlugin",
  "license": "MIT",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/utwente-fmt/vercors-ide/"
  },
  "publisher": "VerCors",
  "categories": [],
  "keywords": [
    "multi-root ready"
  ],
  "engines": {
    "vscode": "^1.84.0"
  },
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:java",
    "onCommand:vercors.lspVerify"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "pvl",
        "path": "./syntaxes/snippets.json"
      },
      {
        "language": "java",
        "path": "./syntaxes/snippets.json"
      },
      {
        "language": "c",
        "path": "./syntaxes/snippets.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "VerCors Configuration",
      "properties": {
        "vercors.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the VerCors server folder (should contain the out.jar and res folders)."
        },
        "vercorsplugin.optionsMap": {
      "type": "object",
      "default": {},
      "description": "Stores custom VerCors options per file or context."
    }
      }
    },
    "languages": [
      {
        "id": "pvl",
        "extensions": [
          ".pvl"
        ],
        "configuration": "./syntaxes/pvl-language-configuration.json"
      },
      {
        "id": "java",
        "extensions": [
          ".java"
        ]
      },
      {
        "id": "vercors-output",
        "aliases": [
          "My Output Channel"
        ],
        "extensions": [
          ".myoutput"
        ]
      }
    ],
    "grammars": [
      {
        "language": "pvl",
        "scopeName": "source.pvl",
        "path": "./syntaxes/pvl.tmLanguage.json"
      },
      {
        "path": "./syntaxes/spec-injection-grammar.tmLanguage.json",
        "scopeName": "source.specification",
        "injectTo": [
          "source.pvl"
        ]
      },
      {
        "path": "syntaxes/comment-injection-java-c.tmLanguage.json",
        "scopeName": "java-comment-spec.injection",
        "injectTo": [
          "source.java",
          "source.c"
        ]
      }
    ],
    "keybindings": [
      {
        "command": "extension.runVercors",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "extension.stopVercors",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q"
      },
      {
        "command": "extension.selectVercorsVersion",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j"
      }
    ],
    "commands": [
      {
        "command": "clientVerify",
        "title": "VerCors: Verify via LSP"
      },
      {
        "command": "stopVerification",
        "title": "Cancel VerCors Verification",
        "category": "VerCors"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vercors-plugin",
          "title": "VerCors Plugin",
          "icon": "resources\\mountain-icon.svg"
        }
      ]
    },
    "views": {
      "vercors-plugin": [
        {
          "id": "vercorsPathView",
          "name": "VerCors Versions",
          "type": "webview"
        },
        {
          "id": "vercorsOptionsView",
          "name": "Options",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "extension.runVercors",
          "when": "view == vercorsPathView",
          "group": "navigation"
        },
        {
          "command": "extension.stopVercors",
          "when": "view == vercorsPathView",
          "group": "navigation"
        }
      ]
    }
  },
"scripts": {
    "build": "vsce package --ignoreFile .vscodeignore-bundled --readme-path INFO.md",
    "clean": "git clean -xfd client/out client/tsconfig.tsbuildinfo",
    "vscode:prepublish": "npm run clean && npm run esbuild-base -- --minify",
    "esbuild": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./client/src/extension.ts --bundle --outfile=./client/out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run clean && tsc -b",
    "watch": "npm run clean && tsc -b -w",
    "lint": "eslint ./client/src --ext .ts,.tsx",
    "postinstall": "cd client && npm install",
    "test": "npm run clean && npm run compile && sh ./scripts/e2e.sh"
}
,
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.14.6",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vscode/vsce": "^2.26.0",
    "chai": "^5.1.0",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "async-wait-until": "^2.0.12",
    "eventemitter3": "^5.0.1",
    "expect.js": "^0.3.1",
    "mock-fs": "^5.2.0",
    "sinon": "^17.0.1",
    "wait-for-event": "^2.0.1",
    "wdio": "^6.0.1"
  }
}
